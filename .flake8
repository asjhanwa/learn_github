[flake8]
max-line-length = 88
max-complexity = 10
ignore = 
    # E203: whitespace before ':'
    E203,
    # W503: line break before binary operator
    W503,
    # W504: line break after binary operator
    W504
exclude = 
    .git,
    __pycache__,
    .pytest_cache,
    .coverage,
    dist,
    build,
    .eggs,
    *.egg-info,
    .tox,
    .venv,
    venv,
    env,
    .env
per-file-ignores = 
    # Tests can have longer lines and more complex functions
    tests/*:E501,C901
    # __init__.py files often have imports that trigger F401
    __init__.py:F401